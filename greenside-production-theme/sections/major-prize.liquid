{%- liquid
  assign featured = all_products[section.settings.product]
  assign has_featured = false
  if featured != blank and featured.id
    assign has_featured = true
  endif

  assign heading = section.settings.heading
  if heading == blank and has_featured
    assign heading = featured.title
  endif

  assign media = section.settings.image
  if media == blank and has_featured
    assign media = featured.featured_media.preview_image
  endif

  assign link_url = section.settings.link
  if link_url == blank and has_featured
    assign link_url = featured.url
  endif

  assign prize_value = featured.metafields.custom.prize_value
  assign cash_alternative = featured.metafields.custom.cash_alternative
  assign media_alt = media.alt | default: heading
-%}

{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

{%- if has_featured or heading != blank -%}
<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="feature{% if section.settings.media_position == 'right' %} feature--reverse{% endif %}">
      <div class="feature__media">
        {%- if media != blank -%}
          {%- render 'responsive-image',
            image: media,
            alt: media_alt,
            sizes: '(min-width: 990px) 620px, 92vw',
            widths: '540,720,900,1200,1600'
          -%}
        {%- else -%}
          {%- render 'placeholder', name: 'product-2' -%}
        {%- endif -%}
      </div>

      <div class="feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="h1">{{ heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="text-lead rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="feature__list" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'icon', icon: 'check', size: 18 -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if has_featured -%}
          {%- render 'competition-progress', product: featured, size: 'large' -%}

          <div class="feature__price-row">
            <span class="competition-card__price">
              <span class="competition-card__price-amount">{{ featured.price | money }}</span>
              <span class="competition-card__price-label">{{ 'products.competition.per_entry' | t }}</span>
            </span>

            {%- if prize_value != blank -%}
              <span class="competition-card__price">
                <span class="competition-card__price-amount">{{ prize_value | metafield_text }}</span>
                <span class="competition-card__price-label">{{ 'products.competition.prize_value' | t }}</span>
              </span>
            {%- endif -%}

            {%- if cash_alternative != blank -%}
              <span class="competition-card__price">
                <span class="competition-card__price-amount">{{ cash_alternative | metafield_text }}</span>
                <span class="competition-card__price-label">{{ 'products.competition.cash_alternative' | t }}</span>
              </span>
            {%- endif -%}
          </div>

          {%- capture major_closing -%}
            {%- render 'competition-closing', product: featured -%}
            {%- render 'competition-closing', product: featured, field: 'draw_at' -%}
          {%- endcapture -%}
          {%- if major_closing != blank -%}
            <div class="competition-card__meta" style="gap: 1.25rem;">{{ major_closing }}</div>
          {%- endif -%}
        {%- endif -%}

        {%- if link_url != blank and section.settings.button_label != blank -%}
          <p>
            <a class="button button--primary button--large" href="{{ link_url }}" data-track="major_prize_click">
              {{- section.settings.button_label | escape -}}
            </a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Major prize",
  "tag": "section",
  "class": "section-major-prize",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "An editorial treatment for your headline competition. Prize value, cash alternative and entry progress appear only when the matching metafields hold real values."
    },
    { "type": "product", "id": "product", "label": "Competition" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The main event" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading",
      "info": "Leave empty to use the competition's own title.",
      "default": "The headline competition"
    },
    { "type": "richtext", "id": "text", "label": "t:sections.all.content" },
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image", "info": "Leave empty to use the competition's own image." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter this competition" },
    { "type": "url", "id": "link", "label": "Button link" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "deep", "label": "t:sections.all.scheme_deep" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" }
      ],
      "default": "deep"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.all.content", "default": "Fitted at a PGA centre of your choice" }
      ]
    }
  ],
  "presets": [{ "name": "Major prize" }]
}
{% endschema %}
