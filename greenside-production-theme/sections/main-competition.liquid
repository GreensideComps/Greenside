{{ 'component-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign prize_value = product.metafields.custom.prize_value
  assign cash_alternative = product.metafields.custom.cash_alternative
  assign closing_at = product.metafields.custom.closing_at.value
  assign skill_question = product.metafields.custom.skill_question.value
  assign skill_answers = product.metafields.custom.skill_answers.value
  assign competition_type = product.metafields.custom.competition_type.value
  assign whats_included = product.metafields.custom.whats_included
  assign how_drawn = product.metafields.custom.how_drawn
  assign eligibility = product.metafields.custom.eligibility
  assign free_entry_url = product.metafields.custom.free_entry_url.value | default: settings.legal_free_entry_url

  comment
    Entry state. A competition is enterable only when Shopify says the product
    is available AND the published closing date has not passed.
  endcomment
  assign is_closed = false
  if closing_at != blank
    assign now_stamp = 'now' | date: '%s' | times: 1
    assign close_stamp = closing_at | date: '%s' | times: 1
    if close_stamp <= now_stamp
      assign is_closed = true
    endif
  endif

  assign can_enter = product.available
  if is_closed
    assign can_enter = false
  endif

-%}

<section class="competition-page" data-competition-page>
  <div class="page-width">
    {%- render 'breadcrumbs' -%}

    <div class="competition-layout">
      <div class="competition-layout__media">
        {%- render 'product-gallery', product: product -%}
      </div>

      <div class="competition-layout__details">
        {%- if section.settings.show_badges -%}
          <div class="competition-page__badges">
            {%- render 'competition-badges', product: product, context: 'page' -%}
          </div>
        {%- endif -%}

        {%- if competition_type != blank -%}
          <span class="eyebrow">{{ competition_type | escape }}</span>
        {%- endif -%}

        <h1 class="competition-page__title h1">{{ product.title | escape }}</h1>

        {%- comment -%}
          Whole pounds. A trailing ".00" is noise at display size, while a
          genuine ".50" survives the removal.
        {%- endcomment -%}
        {%- liquid
          assign prize_value_text = ''
          if prize_value != blank
            assign prize_value_text = prize_value | metafield_text | remove: '.00'
          endif
          assign cash_alternative_text = ''
          if cash_alternative != blank
            assign cash_alternative_text = cash_alternative | metafield_text | remove: '.00'
          endif
        -%}
        {%- if prize_value_text != blank or cash_alternative_text != blank -%}
          <ul class="competition-page__values" role="list">
            {%- if prize_value_text != blank -%}
              <li>
                <span class="competition-page__value-amount">{{ prize_value_text }}</span>
                <span class="competition-page__value-label">{{ 'products.competition.prize_value' | t }}</span>
              </li>
            {%- endif -%}
            {%- if cash_alternative_text != blank -%}
              <li>
                <span class="competition-page__value-amount">{{ cash_alternative_text }}</span>
                <span class="competition-page__value-label">{{ 'products.competition.cash_alternative' | t }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- render 'competition-progress', product: product, size: 'large' -%}

        {%- capture date_meta -%}
          {%- render 'competition-closing', product: product -%}
          {%- render 'competition-closing', product: product, field: 'draw_at' -%}
        {%- endcapture -%}
        {%- if date_meta != blank -%}
          <div class="competition-page__dates">{{ date_meta }}</div>
        {%- endif -%}

        <div class="competition-page__price">
          <span class="competition-page__price-amount">
            {%- if product.price_varies -%}
              {%- assign min_price = product.price_min | money -%}
              {{- 'products.product.from_price' | t: price: min_price -}}
            {%- else -%}
              {{- product.price | money -}}
            {%- endif -%}
          </span>
          <span class="competition-page__price-label">{{ 'products.competition.per_entry' | t }}</span>
        </div>

        {%- if can_enter -%}
          <gs-add-to-cart class="competition-form" data-product-id="{{ product.id }}">
            {%- form 'product',
              product,
              id: 'CompetitionForm',
              class: 'competition-form__form',
              novalidate: 'novalidate'
            -%}
              {%- render 'entry-selector', product: product -%}

              {%- if skill_question != blank -%}
                <fieldset class="skill-question">
                  <legend class="skill-question__legend">
                    {%- render 'icon', icon: 'question', size: 16 -%}
                    {{ 'products.competition.question_heading' | t }}
                  </legend>
                  <p class="skill-question__text">{{ skill_question | escape }}</p>

                  {%- if skill_answers != blank and skill_answers.size > 0 -%}
                    <div class="skill-question__options">
                      {%- for answer in skill_answers -%}
                        <label class="skill-answer" for="SkillAnswer-{{ forloop.index }}">
                          <input
                            id="SkillAnswer-{{ forloop.index }}"
                            type="radio"
                            name="properties[{{ 'products.competition.question_heading' | t }}]"
                            value="{{ answer | escape }}"
                            required
                            data-skill-answer
                          >
                          <span>{{ answer | escape }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                    <p class="field__error" data-skill-error role="alert" hidden>
                      {%- render 'icon', icon: 'warning', size: 14 -%}
                      <span data-skill-error-text></span>
                    </p>
                  {%- else -%}
                    <div class="field">
                      <label class="visually-hidden" for="SkillAnswerText">
                        {{ 'products.competition.question_heading' | t }}
                      </label>
                      <input
                        id="SkillAnswerText"
                        class="field__input"
                        type="text"
                        name="properties[{{ 'products.competition.question_heading' | t }}]"
                        required
                        autocomplete="off"
                      >
                    </div>
                  {%- endif -%}
                </fieldset>
              {%- endif -%}

              <button
                type="submit"
                name="add"
                class="button button--primary button--full button--large competition-form__submit"
              >
                <span class="button__label">
                  {{- settings.entry_cta_label | default: 'Enter now' -}}
                </span>
                <span class="button__spinner"><span class="spinner"></span></span>
              </button>

              <p class="field__error competition-form__error" data-cart-error role="alert" hidden></p>
            {%- endform -%}
          </gs-add-to-cart>

          {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <ul class="competition-form__payments" aria-label="{{ 'footer.payment_methods' | t }}">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- else -%}
          <div class="competition-closed">
            <span class="competition-closed__icon">
              {%- render 'icon', icon: 'flag', size: 24 -%}
            </span>
            {%- if is_closed -%}
              <h2 class="h4">{{ 'products.competition.closed_title' | t }}</h2>
              <p class="text-muted">{{ 'products.competition.closed_body' | t }}</p>
            {%- elsif product.available == false -%}
              <h2 class="h4">{{ 'products.competition.sold_out_title' | t }}</h2>
              <p class="text-muted">{{ 'products.competition.sold_out_body' | t }}</p>
            {%- else -%}
              <h2 class="h4">{{ 'products.competition.unavailable_title' | t }}</h2>
              <p class="text-muted">{{ 'products.competition.unavailable_body' | t }}</p>
            {%- endif -%}
            <div class="flow-gap" style="margin-top: 1rem;">
              <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
                {{- 'products.empty.browse_all' | t -}}
              </a>
              <a class="button button--secondary" href="{{ section.settings.winners_page | default: '/pages/winners' }}">
                {{- 'winners.title' | t -}}
              </a>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Legal and reassurance, always visible. {%- endcomment -%}
        <ul class="competition-page__assurances" role="list">
          {%- if free_entry_url != blank -%}
            <li>
              {%- render 'icon', icon: 'shield', size: 16 -%}
              <a href="{{ free_entry_url }}">{{ 'products.competition.free_entry_link' | t }}</a>
            </li>
          {%- endif -%}
          {%- if settings.legal_competition_rules_url != blank -%}
            <li>
              {%- render 'icon', icon: 'info', size: 16 -%}
              <a href="{{ settings.legal_competition_rules_url }}">
                {{- 'products.competition.rules_link' | t -}}
              </a>
            </li>
          {%- endif -%}
          {%- if settings.legal_min_age != blank -%}
            <li>
              {%- render 'icon', icon: 'lock', size: 16 -%}
              <span>{{ 'products.competition.min_age' | t: age: settings.legal_min_age }}</span>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.show_share -%}
          {%- render 'share-buttons', url: product.url, title: product.title -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Detail accordions. Each panel is skipped when empty. {%- endcomment -%}
    <div class="competition-details">
      <h2 class="h3 competition-details__heading">{{ 'products.competition.details_heading' | t }}</h2>

      <div class="accordion">
        {%- if product.description != blank -%}
          <details class="accordion__item" open>
            <summary class="accordion__summary">
              <span>{{ 'products.competition.prize_heading' | t }}</span>
              {%- render 'icon', icon: 'chevron-down', size: 18 -%}
            </summary>
            <div class="accordion__panel rte">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- if whats_included != blank -%}
          <details class="accordion__item">
            <summary class="accordion__summary">
              <span>{{ 'products.competition.included_heading' | t }}</span>
              {%- render 'icon', icon: 'chevron-down', size: 18 -%}
            </summary>
            <div class="accordion__panel rte">{{ whats_included | metafield_tag }}</div>
          </details>
        {%- endif -%}

        {%- if how_drawn != blank -%}
          <details class="accordion__item">
            <summary class="accordion__summary">
              <span>{{ 'products.competition.how_drawn_heading' | t }}</span>
              {%- render 'icon', icon: 'chevron-down', size: 18 -%}
            </summary>
            <div class="accordion__panel rte">{{ how_drawn | metafield_tag }}</div>
          </details>
        {%- endif -%}

        {%- if eligibility != blank -%}
          <details class="accordion__item">
            <summary class="accordion__summary">
              <span>{{ 'products.competition.terms_heading' | t }}</span>
              {%- render 'icon', icon: 'chevron-down', size: 18 -%}
            </summary>
            <div class="accordion__panel rte">{{ eligibility | metafield_tag }}</div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' and block.settings.content != blank -%}
            <details class="accordion__item" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.heading | escape }}</span>
                {%- render 'icon', icon: 'chevron-down', size: 18 -%}
              </summary>
              <div class="accordion__panel rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Competition",
  "tag": "section",
  "class": "section-main-competition",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prize value, entry progress, closing dates and the skill question all read product metafields. Each is hidden when its metafield is empty — see docs/SHOPIFY-SETUP.md."
    },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "url", "id": "winners_page", "label": "Winners page link" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Extra detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Delivery" },
        { "type": "richtext", "id": "content", "label": "t:sections.all.content" }
      ]
    }
  ]
}
{% endschema %}
