{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="signup{% if section.settings.layout == 'split' %} signup--split{% endif %}">
      <div class="signup__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="text-lead rte" style="margin-top: 0.75rem;">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="signup__benefits">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'icon', icon: 'check', size: 18 -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="signup__form-wrap">
        {%- render 'newsletter-form',
          id: section.id,
          location: section.settings.analytics_label,
          show_name: section.settings.show_name,
          button_label: section.settings.button_label
        -%}

        {%- if section.settings.note != blank -%}
          <p class="signup__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "class": "section-email-signup",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Greenside Club" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Be first on the tee" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.content",
      "default": "<p>New competitions, draw results and early access, straight to your inbox.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Ask for a first name",
      "info": "Keep the form short. A name is enough to personalise email without slowing anyone down.",
      "default": true
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Club" },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Free to join. Unsubscribe any time."
    },
    {
      "type": "text",
      "id": "analytics_label",
      "label": "Analytics label",
      "info": "Recorded with the email_signup event so you can tell your signup points apart.",
      "default": "homepage"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Two columns" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" }
      ],
      "default": "brand"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.padding_top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.padding_bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.all.content", "default": "New competitions before they go public" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Email signup",
      "blocks": [
        { "type": "benefit", "settings": { "text": "New competitions before they go public" } },
        { "type": "benefit", "settings": { "text": "Draw results the moment they're in" } },
        { "type": "benefit", "settings": { "text": "Club-only competitions as they launch" } }
      ]
    }
  ]
}
{% endschema %}
