{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="{% if section.settings.narrow %}page-width--narrow{% else %}page-width{% endif %}">
    <div class="rich-text{% if section.settings.alignment == 'center' %} center{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
          {%- when 'text' -%}
            <div class="rte{% if block.settings.large %} text-lead{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'button' -%}
            <p {{ block.shopify_attributes }}>
              <a class="button button--{{ block.settings.style }}" href="{{ block.settings.link | default: '#' }}">
                {{- block.settings.label | escape -}}
              </a>
            </p>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    { "type": "checkbox", "id": "narrow", "label": "Narrow column", "default": true },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.alignment",
      "options": [
        { "value": "left", "label": "t:sections.all.align_left" },
        { "value": "center", "label": "t:sections.all.align_center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "t:sections.all.content" }]
    },
    {
      "type": "heading",
      "name": "t:blocks.all.heading",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.all.content", "default": "Premium prizes. Affordable entries." },
        {
          "type": "select",
          "id": "size",
          "label": "t:sections.all.heading_size",
          "options": [
            { "value": "h3", "label": "t:sections.all.size_small" },
            { "value": "h2", "label": "t:sections.all.size_medium" },
            { "value": "h1", "label": "t:sections.all.size_large" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:blocks.all.text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>Say something worth reading.</p>" },
        { "type": "checkbox", "id": "large", "label": "Larger text", "default": false }
      ]
    },
    {
      "type": "button",
      "name": "t:blocks.all.button",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.all.link_label", "default": "Browse competitions" },
        { "type": "url", "id": "link", "label": "t:sections.all.link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
