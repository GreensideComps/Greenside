{%- comment -%}
  Greenside Club.

  The Club backend does not exist yet, so this section does not pretend it does.
  It presents what the Club is and captures email through the same Shopify
  customer form as every other signup on the store. Tiers, points and member
  status are deliberately absent until there is a real system behind them.

  When a loyalty provider is connected, `docs/INTEGRATIONS.md` describes where
  member state plugs in without changing this markup.
{%- endcomment -%}

{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--highlight">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="text-lead rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="club-grid" role="list">
        {%- for block in section.blocks -%}
          <li class="club-card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="club-card__icon">{%- render 'icon', icon: block.settings.icon, size: 22 -%}</span>
            {%- endif -%}
            <h3 class="club-card__title h4">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="club-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="club-signup">
      {%- render 'newsletter-form',
        id: section.id,
        location: 'club',
        show_name: true,
        button_label: section.settings.button_label
      -%}
      {%- if section.settings.note != blank -%}
        <p class="signup__note center">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Greenside Club",
  "tag": "section",
  "class": "section-club",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Describes what the Club will offer and collects email. Member status, points and tiers are intentionally not shown until a loyalty provider is connected — see docs/INTEGRATIONS.md."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Membership" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "The Greenside Club" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.content",
      "default": "<p>Free to join. Built for people who'd rather hear about a competition before everyone else does.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Club" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Free to join. Unsubscribe any time." },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "deep", "label": "t:sections.all.scheme_deep" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" }
      ],
      "default": "deep"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "clock", "label": "Clock" },
            { "value": "ticket", "label": "Ticket" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" },
            { "value": "users", "label": "People" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "trophy", "label": "Trophy" }
          ],
          "default": "clock"
        },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Early access" },
        { "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>See new competitions before they go public.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Greenside Club",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "clock", "heading": "Early access", "text": "<p>See new competitions before they go public.</p>" } },
        { "type": "benefit", "settings": { "icon": "ticket", "heading": "Club competitions", "text": "<p>Competitions we only open to members.</p>" } },
        { "type": "benefit", "settings": { "icon": "trophy", "heading": "Results first", "text": "<p>Every draw result, straight to your inbox.</p>" } }
      ]
    }
  ]
}
{% endschema %}
