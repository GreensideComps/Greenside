{{ 'component-account.css' | asset_url | stylesheet_tag }}

<div class="account-page">
  <div class="page-width">
    <div class="auth-card">
      <div class="auth-card__header">
        <h1 class="h3">{{ 'customer.reset_password.title' | t }}</h1>
      </div>

      {%- form 'reset_customer_password', class: 'auth-form', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" role="alert">
            {%- render 'icon', icon: 'warning', size: 16 -%}
            <span>{{ form.errors.messages.form }}</span>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input id="ResetPassword" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">
            {{- 'customer.reset_password.password_confirm' | t -}}
          </label>
          <input id="ResetPasswordConfirm" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary button--full">
          {{- 'customer.reset_password.submit' | t -}}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-main-reset",
  "settings": []
}
{% endschema %}
