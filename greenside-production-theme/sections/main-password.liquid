{%- comment -%}
  Password page content. Rendered inside layout/password.liquid, which is a
  separate, minimal layout — the storefront header and footer are unavailable
  on a password-protected store.
{%- endcomment -%}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_alt = hero_image.alt | default: shop.name
-%}

<div class="password-page">
  <div class="password-page__media">
    {%- if hero_image != blank -%}
      {%- render 'responsive-image',
        image: hero_image,
        alt: hero_alt,
        sizes: '100vw',
        widths: '750,1100,1600,2000',
        loading: 'eager',
        fetchpriority: 'high'
      -%}
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="password-page__content page-width">
    <div class="password-page__inner">
      {%- if settings.logo_light != blank or settings.logo != blank -%}
        {%- assign password_logo = settings.logo_light | default: settings.logo -%}
        <img
          class="password-page__logo"
          src="{{ password_logo | image_url: width: 480 }}"
          alt="{{ shop.name | escape }}"
          width="{{ password_logo.width }}"
          height="{{ password_logo.height }}"
        >
      {%- else -%}
        <p class="header__logo-text">{{ shop.name }}</p>
      {%- endif -%}

      {%- assign password_heading = 'page.password.title' | t -%}
      <h1 class="h1">{{ section.settings.heading | default: password_heading | escape }}</h1>

      {%- if section.settings.text != blank -%}
        <div class="text-lead rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        <div class="password-page__signup">
          {%- render 'newsletter-form', id: 'password', location: 'password', show_name: false -%}
        </div>
      {%- endif -%}

      <details class="password-page__login">
        <summary>{{ 'page.password.login_prompt' | t }}</summary>
        {%- form 'storefront_password', class: 'password-page__form' -%}
          <div class="field{% if form.errors %} field--error{% endif %}">
            <label class="visually-hidden" for="StorefrontPassword">
              {{- 'page.password.password' | t -}}
            </label>
            <input
              id="StorefrontPassword"
              class="field__input"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'page.password.password' | t }}"
              {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
            >
            {%- if form.errors -%}
              <p class="field__error" id="PasswordError" role="alert">
                {%- render 'icon', icon: 'warning', size: 14 -%}
                {{ 'page.password.error' | t }}
              </p>
            {%- endif -%}
          </div>
          <button type="submit" class="button button--primary">{{ 'page.password.submit' | t }}</button>
        {%- endform -%}
      </details>

      {%- render 'social-links' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Opening soon" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.content",
      "default": "<p>Premium golf prizes. Affordable entries. Join the list and we'll tell you the moment the first competition opens.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true }
  ]
}
{% endschema %}
