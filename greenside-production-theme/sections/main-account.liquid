{{ 'component-account.css' | asset_url | stylesheet_tag }}

<div class="account-page">
  <div class="page-width">
    <div class="account-header">
      <div>
        <h1 class="h2">{{ 'customer.account.title' | t }}</h1>
        {%- assign greeting_name = customer.first_name | default: customer.email -%}
        <p class="text-muted">
          {{- 'customer.account.welcome' | t: name: greeting_name -}}
        </p>
      </div>
    </div>

    <div class="account-layout">
      {%- render 'account-nav', current: 'orders' -%}

      <div>
        <section class="account-panel">
          <h2 class="h4 account-panel__title">{{ 'customer.account.orders' | t }}</h2>

          {%- paginate customer.orders by 12 -%}
            {%- if customer.orders.size > 0 -%}
              <table class="order-table">
                <thead>
                  <tr>
                    <th scope="col">{{ 'customer.account.order_number' | t }}</th>
                    <th scope="col">{{ 'customer.account.date' | t }}</th>
                    <th scope="col">{{ 'customer.account.payment_status' | t }}</th>
                    <th scope="col">{{ 'customer.account.fulfillment_status' | t }}</th>
                    <th scope="col">{{ 'customer.account.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td data-label="{{ 'customer.account.order_number' | t }}">
                        <a class="link" href="{{ order.customer_url }}">{{ order.name }}</a>
                      </td>
                      <td data-label="{{ 'customer.account.date' | t }}">
                        {{ order.created_at | date: '%-d %b %Y' }}
                      </td>
                      <td data-label="{{ 'customer.account.payment_status' | t }}">
                        <span class="order-status order-status--{{ order.financial_status | handle }}">
                          {{- order.financial_status_label -}}
                        </span>
                      </td>
                      <td data-label="{{ 'customer.account.fulfillment_status' | t }}">
                        <span class="order-status order-status--{{ order.fulfillment_status | handle }}">
                          {{- order.fulfillment_status_label -}}
                        </span>
                      </td>
                      <td data-label="{{ 'customer.account.total' | t }}">{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>

              {%- if paginate.pages > 1 -%}
                {%- render 'pagination', paginate: paginate -%}
              {%- endif -%}

              {%- comment -%}
                Entry numbers are issued by the draw system, not by Shopify.
                Rather than invent them, the theme points to where they really
                are. See docs/INTEGRATIONS.md for wiring a provider in here.
              {%- endcomment -%}
              <p class="entries-note">
                {%- render 'icon', icon: 'info', size: 16 -%}
                <span>{{ 'customer.account.entries_note' | t }}</span>
              </p>
            {%- else -%}
              <div class="empty-state">
                <span class="empty-state__icon">{%- render 'icon', icon: 'ticket', size: 28 -%}</span>
                <p class="h4">{{ 'customer.account.no_orders_title' | t }}</p>
                <p class="empty-state__text">{{ 'customer.account.no_orders_body' | t }}</p>
                <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
                  {{- 'products.empty.browse_all' | t -}}
                </a>
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </section>

        <section class="account-panel">
          <h2 class="h4 account-panel__title">{{ 'customer.account.details' | t }}</h2>
          <p>{{ customer.name }}</p>
          <p class="text-muted">{{ customer.email }}</p>
          {%- if customer.default_address -%}
            <div class="text-muted" style="margin-top: 0.75rem;">
              {{ customer.default_address | format_address }}
            </div>
          {%- endif -%}
          <p style="margin-top: 1rem;">
            <a class="link" href="{{ routes.account_addresses_url }}">
              {{- 'customer.account.view_addresses' | t -}}
            </a>
          </p>
        </section>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "tag": "section",
  "class": "section-main-account",
  "settings": []
}
{% endschema %}
