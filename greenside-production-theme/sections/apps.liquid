{%- comment -%}
  Host for app blocks, so apps can be placed on a page without theme changes.
{%- endcomment -%}
{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

{%- if section.blocks.size > 0 -%}
  <div class="section">
    <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>{%- render block -%}</div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "section-apps",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
