{%- comment -%}
  Host for app blocks, so apps can be placed on a page without theme changes.
{%- endcomment -%}
{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

{%- if section.blocks.size > 0 -%}
  <div class="section">
    <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %}">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>{%- render block -%}</div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "section-apps",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
