{%- assign tile_style = '--category-columns: ' | append: section.settings.columns_desktop | append: ';' -%}
{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom,
  extra: tile_style
-%}

{%- comment -%}
  A tile only renders when it resolves to a URL, so count them before drawing
  the heading: a heading with nothing beneath it looks broken on a new store.
{%- endcomment -%}
{%- liquid
  assign resolvable_tiles = 0
  for block in section.blocks
    assign block_collection = collections[block.settings.collection]
    if block.settings.link != blank or block_collection != blank
      assign resolvable_tiles = resolvable_tiles | plus: 1
    endif
  endfor
-%}

{%- if resolvable_tiles > 0 -%}
<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="text-muted">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="category-grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = collections[block.settings.collection]
            assign tile_title = block.settings.heading
            if tile_title == blank
              assign tile_title = block_collection.title
            endif
            assign tile_image = block.settings.image
            if tile_image == blank
              assign tile_image = block_collection.featured_image
            endif
            assign tile_url = block.settings.link
            if tile_url == blank and block_collection != blank
              assign tile_url = block_collection.url
            endif
            assign tile_alt = tile_image.alt | default: tile_title
          -%}
          {%- if tile_url != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="category-tile" href="{{ tile_url }}" data-track="category_click">
                <div class="category-tile__media">
                  {%- if tile_image != blank -%}
                    {%- render 'responsive-image',
                      image: tile_image,
                      alt: tile_alt,
                      sizes: '(min-width: 750px) 300px, 45vw',
                      widths: '300,420,600,800'
                    -%}
                  {%- else -%}
                    {%- render 'placeholder', name: 'collection-1' -%}
                  {%- endif -%}
                </div>
                <div class="category-tile__content">
                  <span class="category-tile__title">{{ tile_title | escape }}</span>
                  {%- if block.settings.show_count and block_collection != blank -%}
                    <span class="category-tile__count">
                      {{- 'products.facets.showing' | t: count: block_collection.all_products_count -}}
                    </span>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Browse categories",
  "tag": "section",
  "class": "section-category-tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Browse competitions" },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.all.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.all.collection" },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "info": "Leave empty to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image", "info": "Leave empty to use the collection image." },
        { "type": "url", "id": "link", "label": "t:sections.all.link", "info": "Leave empty to link to the collection." },
        { "type": "checkbox", "id": "show_count", "label": "Show how many competitions are in it", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
