{{ 'component-account.css' | asset_url | stylesheet_tag }}

<div class="account-page">
  <div class="page-width">
    <div class="auth-card">
      <div class="auth-card__header">
        <h1 class="h3">{{ 'customer.activate_account.title' | t }}</h1>
        <p>{{ 'customer.activate_account.subtitle' | t }}</p>
      </div>

      {%- form 'activate_customer_password', class: 'auth-form', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" role="alert">
            {%- render 'icon', icon: 'warning', size: 16 -%}
            <span>{{ form.errors.messages.form }}</span>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input id="ActivatePassword" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">
            {{- 'customer.activate_account.password_confirm' | t -}}
          </label>
          <input id="ActivatePasswordConfirm" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <div class="auth-form__actions">
          <button type="submit" name="commit" class="button button--primary button--full">
            {{- 'customer.activate_account.submit' | t -}}
          </button>
          <button type="submit" name="decline" class="button button--ghost">
            {{- 'customer.activate_account.decline' | t -}}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "tag": "section",
  "class": "section-main-activate",
  "settings": []
}
{% endschema %}
