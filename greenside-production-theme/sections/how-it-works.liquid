{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.alignment == 'center' %} section-header--center{% endif %}">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="text-lead">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <h3 class="step__title h4">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="step__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.link != blank -%}
      <p class="{% if section.settings.alignment == 'center' %}center{% endif %}" style="margin-top: 2.5rem;">
        <a class="button button--primary" href="{{ section.settings.link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </p>
    {%- endif -%}

    {%- if section.settings.legal_note != blank -%}
      <div class="rte text-xs text-muted" style="margin-top: 2rem; max-width: 70ch;">
        {{ section.settings.legal_note }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "section-how-it-works",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "How it works" },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" },
    {
      "type": "richtext",
      "id": "legal_note",
      "label": "Legal note",
      "info": "Use this for your free entry route and draw rules. Wording should be confirmed with your legal adviser."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.alignment",
      "options": [
        { "value": "left", "label": "t:sections.all.align_left" },
        { "value": "center", "label": "t:sections.all.align_center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Pick a competition" },
        { "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>Browse what's open and find a prize you actually want.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Pick a competition", "text": "<p>Browse what's open and find a prize you actually want.</p>" } },
        { "type": "step", "settings": { "heading": "Choose your entries", "text": "<p>Entry price is per entry. Take one or take more — it's up to you.</p>" } },
        { "type": "step", "settings": { "heading": "Answer the question", "text": "<p>A short golf question at checkout. It's what makes this a competition of skill.</p>" } },
        { "type": "step", "settings": { "heading": "Wait for the draw", "text": "<p>Entries close on the published date and the draw follows. Every winner is published.</p>" } }
      ]
    }
  ]
}
{% endschema %}
