{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

{%- if section.blocks.size > 0 -%}
  <div class="section scheme-{{ section.settings.colour_scheme }} trust-bar">
    <div class="page-width">
      <ul class="trust-bar__list" role="list">
        {%- for block in section.blocks -%}
          <li class="trust-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="trust-bar__icon">{%- render 'icon', icon: block.settings.icon, size: 20 -%}</span>
            {%- endif -%}
            <span>
              <span class="trust-bar__title">{{ block.settings.heading | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="trust-bar__text" style="display:block;">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section-trust-bar",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only state things you can evidence. Prize totals and winner counts should be checked before they go live."
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 50 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "lock", "label": "Lock" },
            { "value": "ticket", "label": "Ticket" },
            { "value": "users", "label": "People" },
            { "value": "flag", "label": "Flag" },
            { "value": "check-circle", "label": "Tick" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Free entry route" },
        { "type": "text", "id": "text", "label": "t:sections.all.subheading", "default": "On every competition, no purchase needed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "shield", "heading": "Free entry route", "text": "On every competition, no purchase needed" } },
        { "type": "item", "settings": { "icon": "ticket", "heading": "Capped entries", "text": "Entry numbers published up front" } },
        { "type": "item", "settings": { "icon": "trophy", "heading": "Every winner published", "text": "Results posted after each draw" } },
        { "type": "item", "settings": { "icon": "lock", "heading": "Secure checkout", "text": "Card payments handled by Shopify" } }
      ]
    }
  ]
}
{% endschema %}
