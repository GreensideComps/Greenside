{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

{%- liquid
  assign feature_image = section.settings.image
  assign feature_alt = feature_image.alt | default: section.settings.heading
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="feature{% if section.settings.media_position == 'right' %} feature--reverse{% endif %}">
      <div class="feature__media">
        {%- if feature_image != blank -%}
          {%- render 'responsive-image',
            image: feature_image,
            alt: feature_alt,
            sizes: '(min-width: 990px) 620px, 92vw',
            widths: '540,720,900,1200'
          -%}
        {%- else -%}
          {%- render 'placeholder', name: 'lifestyle-1' -%}
        {%- endif -%}
      </div>

      <div class="feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.link != blank -%}
          <p>
            <a class="button button--{{ section.settings.button_style }}" href="{{ section.settings.link }}">
              {{- section.settings.button_label | escape -}}
            </a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-content-feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Built by golfers" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.content",
      "default": "<p>Tell the story behind Greenside. Keep it short and keep it honest.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
