{%- comment -%}
  Recently viewed competitions.

  Handles are stored in the visitor's own browser by theme.js and never leave
  it. The section requests those products from Shopify's search endpoint at
  render time, so prices and availability are always live rather than cached
  from the earlier visit.

  Renders nothing at all until there is real history, so a first-time visitor
  never sees an empty rail.
{%- endcomment -%}

{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

<gs-recently-viewed
  class="section scheme-{{ section.settings.colour_scheme }}"
  data-limit="{{ section.settings.products_to_show }}"
  data-heading="{{ section.settings.heading | escape }}"
  hidden
>
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <ul class="competition-grid" role="list" data-recently-viewed-list></ul>
  </div>
</gs-recently-viewed>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    {
      "type": "paragraph",
      "content": "Stored in the visitor's own browser. The section stays hidden until they have viewed a competition."
    },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Recently viewed" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "t:sections.all.products_to_show", "default": 4 },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ]
}
{% endschema %}
