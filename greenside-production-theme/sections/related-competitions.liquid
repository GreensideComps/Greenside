{%- comment -%}
  Related competitions.

  Uses Shopify's Product Recommendations API, which blends catalogue
  relationships with real order behaviour. Requested over the network so the
  product page itself stays cacheable.

  This is the extension point for future personalisation: swap the URL below
  for your own ranked endpoint returning the same section markup, and every
  card, badge and progress bar keeps working unchanged. See docs/INTEGRATIONS.md.
{%- endcomment -%}

{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

<gs-recommendations
  class="section scheme-{{ section.settings.colour_scheme }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  data-product-id="{{ product.id }}"
>
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="page-width">
        <div class="section-header">
          <div class="section-header__text">
            <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>

        <ul class="competition-grid" role="list">
          {%- for recommendation in recommendations.products -%}
            <li>
              {%- render 'competition-card',
                product: recommendation,
                index: forloop.index,
                sizes: '(min-width: 990px) 300px, (min-width: 600px) 45vw, 78vw'
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- comment -%} Placeholder height prevents layout shift while loading. {%- endcomment -%}
    <div class="page-width"><div class="recommendations__skeleton" aria-hidden="true"></div></div>
  {%- endif -%}
</gs-recommendations>

{% schema %}
{
  "name": "Related competitions",
  "tag": "section",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Other competitions you can enter" },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related to this competition" },
        { "value": "complementary", "label": "Often entered together" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "t:sections.all.products_to_show", "default": 4 },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ]
}
{% endschema %}
