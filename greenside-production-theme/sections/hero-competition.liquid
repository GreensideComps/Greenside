{%- comment -%}
  The hero.

  One competition, at scale. The page's job in the first screen is to present a
  single prize as though it matters, not to offer a choice of twelve.

  Everything shown is real: the price comes from the product, the closing date
  from custom.closing_at, and the entry line only appears when the competition
  is genuinely open. Nothing counts down.
{%- endcomment -%}

{%- liquid
  assign featured = all_products[section.settings.product]
  assign has_featured = false
  if featured != blank and featured.id
    assign has_featured = true
  endif

  assign image_desktop = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: section.settings.image

  if image_desktop == blank and has_featured
    assign image_desktop = featured.featured_media.preview_image
    assign image_mobile = featured.featured_media.preview_image
  endif

  comment
    The heading falls through so the page always carries exactly one h1, even on
    a freshly installed theme with nothing selected.
  endcomment
  assign heading = section.settings.heading
  if heading == blank and has_featured
    assign heading = featured.title
  endif
  if heading == blank
    assign heading = settings.brand_tagline
  endif
  if heading == blank
    assign heading = shop.name
  endif

  assign hero_link = section.settings.link
  if hero_link == blank and has_featured
    assign hero_link = featured.url
  endif
  if hero_link == blank
    assign hero_link = routes.all_products_collection_url
  endif

  assign closing_at = featured.metafields.custom.closing_at.value
  assign is_closed = false
  if closing_at != blank
    assign now_stamp = 'now' | date: '%s' | times: 1
    assign close_stamp = closing_at | date: '%s' | times: 1
    if close_stamp <= now_stamp
      assign is_closed = true
    endif
  endif
  assign can_enter = false
  if has_featured and featured.available and is_closed == false
    assign can_enter = true
  endif

  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign hero_alt = image_desktop.alt | default: heading
  assign hero_style = '--hero-overlay: ' | append: overlay | append: ';'
-%}

{%- render 'section-styles', id: section.id, top: 'none', bottom: 'none', extra: hero_style -%}

<section class="hero hero--{{ section.settings.height }}" data-hero>
  <div class="hero__media">
    {%- if image_desktop != blank -%}
      <picture>
        {%- if image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          src="{{ image_desktop | image_url: width: 2000 }}"
          srcset="
            {{ image_desktop | image_url: width: 1000 }} 1000w,
            {{ image_desktop | image_url: width: 1500 }} 1500w,
            {{ image_desktop | image_url: width: 2000 }} 2000w,
            {{ image_desktop | image_url: width: 2600 }} 2600w
          "
          sizes="100vw"
          alt="{{ hero_alt | escape }}"
          width="{{ image_desktop.width }}"
          height="{{ image_desktop.height }}"
          fetchpriority="high"
          loading="eager"
        >
      </picture>
    {%- else -%}
      <div class="hero__fallback"></div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content">
    <div class="page-width">
      <div class="hero__inner">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <h1 class="hero__title h0">{{ heading | escape }}</h1>

        {%- if section.settings.text != blank -%}
          <div class="hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- comment -%}
          One entry line: price, closing date, action. No progress bar, no
          counter, no badge. The prize is the hero; this is the caption.
        {%- endcomment -%}
        {%- if has_featured -%}
          <div class="hero__entry">
            {%- if can_enter -%}
              <p class="hero__price">
                <span class="hero__price-amount num">{{ featured.price | money }}</span>
                <span class="hero__price-label">{{ 'products.competition.per_entry' | t }}</span>
              </p>
            {%- endif -%}

            <div class="hero__actions">
              <a class="button button--primary button--large" href="{{ hero_link }}" data-track="hero_cta_click">
                {%- if can_enter -%}
                  {{ section.settings.button_label | default: 'Enter' | escape }}
                {%- else -%}
                  {{ 'products.competition.view_competition' | t }}
                {%- endif -%}
              </a>

              {%- if section.settings.secondary_link != blank and section.settings.secondary_label != blank -%}
                <a class="button button--ghost-light button--large" href="{{ section.settings.secondary_link }}">
                  {{- section.settings.secondary_label | escape -}}
                </a>
              {%- endif -%}
            </div>

            {%- capture hero_closing -%}
              {%- render 'competition-closing', product: featured, icon: false -%}
            {%- endcapture -%}
            {%- if hero_closing != blank -%}
              <p class="hero__closing num">{{ hero_closing }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="hero__actions">
            <a class="button button--primary button--large" href="{{ hero_link }}" data-track="hero_cta_click">
              {{- section.settings.button_label | default: 'Browse competitions' | escape -}}
            </a>
            {%- if section.settings.secondary_link != blank and section.settings.secondary_label != blank -%}
              <a class="button button--ghost-light button--large" href="{{ section.settings.secondary_link }}">
                {{- section.settings.secondary_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero competition",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "One competition, at full scale. Leave the heading, image or link empty and the featured competition fills them in. Nothing here counts down or shows a progress bar — the hero presents the prize, the competition page does the detail."
    },
    { "type": "product", "id": "product", "label": "Featured competition" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.all.eyebrow", "default": "This week" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading",
      "info": "Leave empty to use the featured competition's own title."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.content",
      "default": "<p>Real golf kit. Capped entries. Every draw filmed and published.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "How the draw works" },
    { "type": "url", "id": "secondary_link", "label": "Second button link" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:sections.all.image_mobile" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image darkening",
      "info": "Higher values keep the headline readable over a busy photograph.",
      "default": 55
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "tall", "label": "Tall" },
        { "value": "full", "label": "Full screen" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "tall"
    }
  ],
  "presets": [{ "name": "Hero competition" }]
}
{% endschema %}
