{%- comment -%}
  FAQ.

  Questions come from section blocks, or from the `faq` metaobject when one is
  selected — metaobjects are the better home for questions reused across several
  pages. FAQPage structured data is emitted only for real question and answer
  pairs.
{%- endcomment -%}

{%- liquid
  assign metaobject_faqs = shop.metaobjects.faq.values
  assign use_metaobject = false
  if section.settings.source == 'metaobject' and metaobject_faqs.size > 0
    assign use_metaobject = true
  endif
-%}

{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="accordion">
      {%- if use_metaobject -%}
        {%- for faq in metaobject_faqs -%}
          {%- if faq.question.value != blank -%}
            <details class="accordion__item">
              <summary class="accordion__summary">
                <span>{{ faq.question.value | escape }}</span>
                {%- render 'icon', icon: 'chevron-down', size: 18 -%}
              </summary>
              <div class="accordion__panel rte">{{ faq.answer | metafield_tag }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details class="accordion__item" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{{ block.settings.question | escape }}</span>
                {%- render 'icon', icon: 'chevron-down', size: 18 -%}
              </summary>
              <div class="accordion__panel rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.link != blank and section.settings.link_label != blank -%}
      <p class="center" style="margin-top: 2rem;">
        <a class="button button--secondary" href="{{ section.settings.link }}">
          {{- section.settings.link_label | escape -}}
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} FAQPage schema, built only from questions that actually exist. {%- endcomment -%}
{%- capture faq_schema -%}
  {%- if use_metaobject -%}
    {%- for faq in metaobject_faqs -%}
      {%- if faq.question.value != blank and faq.answer.value != blank -%}
        {%- capture faq_answer_html -%}{{ faq.answer | metafield_tag }}{%- endcapture -%}
        {%- assign faq_answer_text = faq_answer_html | strip_html | strip -%}
        {
          "@type": "Question",
          "name": {{ faq.question.value | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_text | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if faq_schema != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_schema }}]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Questions come from",
      "options": [
        { "value": "blocks", "label": "Blocks in this section" },
        { "value": "metaobject", "label": "The FAQ metaobject" }
      ],
      "info": "Use the metaobject when the same questions appear on more than one page.",
      "default": "blocks"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Common questions" },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Is there a free entry route?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Every competition has a free entry route, set out in the competition rules.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
