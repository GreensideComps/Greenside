{%- liquid
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_to_show | default: 3
-%}

{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

{%- comment -%}
  Hidden entirely when the blog is empty. An "it's coming" placeholder is dead
  space on a homepage — unlike the winners rail, whose empty state explains the
  publishing promise and therefore earns its place.
{%- endcomment -%}
{%- if blog.articles_count > 0 -%}
<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if blog != blank and blog.articles_count > 0 -%}
        <a class="link" href="{{ blog.url }}">
          {{- 'general.view_all' | t }}
          {%- render 'icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
      <ul class="article-grid" role="list">
        {%- for article in blog.articles limit: limit -%}
          {%- assign article_alt = article.image.alt | default: article.title -%}
          <li>
            <article class="article-card">
              <a class="article-card__link" href="{{ article.url }}">
                <div class="article-card__media media media--wide">
                  {%- if article.image -%}
                    {%- render 'responsive-image',
                      image: article.image,
                      alt: article_alt,
                      sizes: '(min-width: 990px) 400px, 92vw',
                      widths: '400,560,720,900'
                    -%}
                  {%- else -%}
                    {%- render 'placeholder', name: 'lifestyle-2' -%}
                  {%- endif -%}
                </div>
                <div class="article-card__body">
                  <p class="article-card__meta">
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{- article.published_at | date: '%-d %b %Y' -}}
                    </time>
                  </p>
                  <h3 class="article-card__title h4">{{ article.title | escape }}</h3>
                  {%- if article.excerpt_or_content != blank -%}
                    <p class="article-card__excerpt">
                      {{- article.excerpt_or_content | strip_html | truncate: 120 -}}
                    </p>
                  {%- endif -%}
                </div>
              </a>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-blog-rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "From the clubhouse" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
