{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 8
  assign products = collection.products
  assign count = products.size
  assign columns = section.settings.columns_desktop | default: 4
  assign mobile_layout = section.settings.mobile_layout | default: 'carousel'

  comment
    A heading is merchant-entered copy and can name a quantity ("Four
    competitions taking entries"). When the collection is empty that heading
    becomes a false claim sitting directly above an empty state saying the
    opposite, so the empty case takes its own heading instead of the merchant's.
  endcomment
  assign heading = section.settings.heading
  assign eyebrow = section.settings.eyebrow
  assign subheading = section.settings.subheading
  if count == 0
    assign empty_heading_default = 'products.empty.collection_title' | t
    assign heading = section.settings.empty_heading | default: empty_heading_default
    assign eyebrow = ''
    assign subheading = ''
  endif
-%}

{%- assign grid_style = '--columns-desktop: ' | append: columns | append: ';' -%}
{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom,
  extra: grid_style
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    {%- if heading != blank or eyebrow != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if eyebrow != blank -%}
            <span class="eyebrow">{{ eyebrow | escape }}</span>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="{{ section.settings.heading_size }}">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if subheading != blank -%}
            <p class="text-muted">{{ subheading | escape }}</p>
          {%- endif -%}
        </div>

        <div class="section-header__actions flow-gap">
          {%- comment -%}
            The header link only appears when the grid already shows everything.
            When there is more to see, the button below the grid does that job,
            and two "view all" controls in one section is one too many.
          {%- endcomment -%}
          {%- if section.settings.show_view_all and collection != blank and count > 0 and count <= limit -%}
            <a class="link" href="{{ collection.url }}">
              {{- 'general.view_all' | t }}
              {%- render 'icon', icon: 'arrow-right', size: 16 -%}
            </a>
          {%- endif -%}

          {%- if mobile_layout == 'carousel' and count > 1 -%}
            <div class="carousel-controls hide-mobile">
              <button type="button" class="carousel-button" data-carousel-prev aria-label="{{ 'general.accessibility.previous' | t }}">
                {%- render 'icon', icon: 'chevron-left', size: 18 -%}
              </button>
              <button type="button" class="carousel-button" data-carousel-next aria-label="{{ 'general.accessibility.next' | t }}">
                {%- render 'icon', icon: 'chevron-right', size: 18 -%}
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      {%- if mobile_layout == 'carousel' -%}
        <gs-carousel>
          <ul
            class="competition-grid competition-grid--carousel"
            data-carousel-track
            role="list"
          >
            {%- for product in products limit: limit -%}
              <li>
                {%- render 'competition-card',
                  product: product,
                  index: forloop.index,
                  image_ratio: section.settings.image_ratio,
                  sizes: '(min-width: 990px) 320px, 78vw'
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </gs-carousel>
      {%- else -%}
        {%- comment -%}
          One competition in a four-column grid reads as a catalogue that
          failed to load, and the single-competition state is the realistic
          launch state rather than an edge case. At a count of one the list
          takes a modifier that lays the card out full width, image beside
          detail, at feature scale. Same card markup either way, so there is
          no second component to keep in step.
        {%- endcomment -%}
        {%- if count == 1 -%}
          {%- assign grid_class = 'competition-grid competition-grid--single' -%}
          {%- assign card_sizes = '(min-width: 750px) 50vw, 92vw' -%}
          {%- assign card_loading = 'eager' -%}
        {%- else -%}
          {%- assign grid_class = 'competition-grid' -%}
          {%- assign card_sizes = '(min-width: 990px) 320px, (min-width: 600px) 45vw, 92vw' -%}
          {%- assign card_loading = 'lazy' -%}
        {%- endif -%}
        <ul class="{{ grid_class }}" role="list">
          {%- for product in products limit: limit -%}
            <li>
              {%- render 'competition-card',
                product: product,
                index: forloop.index,
                image_ratio: section.settings.image_ratio,
                loading: card_loading,
                sizes: card_sizes
              -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_view_all and collection != blank and count > limit -%}
        <p class="center" style="margin-top: 2rem;">
          <a class="button button--secondary" href="{{ collection.url }}">
            {{- 'general.view_all' | t }} &mdash; {{ collection.title | escape -}}
          </a>
        </p>
      {%- endif -%}
    {%- else -%}
      {%- assign empty_body_default = 'products.empty.collection_body' | t -%}
      {%- assign empty_body = section.settings.empty_text | default: empty_body_default -%}
      {%- render 'empty-state', body: empty_body -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Competition grid",
  "tag": "section",
  "class": "section-competition-grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Open competitions" },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading" },
    { "type": "header", "content": "t:sections.all.empty_header" },
    { "type": "paragraph", "content": "t:sections.all.empty_intro" },
    { "type": "text", "id": "empty_heading", "label": "t:sections.all.empty_heading" },
    { "type": "textarea", "id": "empty_text", "label": "t:sections.all.empty_text" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size",
      "options": [
        { "value": "h3", "label": "t:sections.all.size_small" },
        { "value": "h2", "label": "t:sections.all.size_medium" },
        { "value": "h1", "label": "t:sections.all.size_large" }
      ],
      "default": "h2"
    },
    { "type": "collection", "id": "collection", "label": "t:sections.all.collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "t:sections.all.products_to_show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.all.columns_desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.all.mobile_layout",
      "options": [
        { "value": "carousel", "label": "t:sections.all.layout_carousel" },
        { "value": "grid", "label": "t:sections.all.layout_grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "landscape"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.all.show_view_all", "default": true },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "presets": [{ "name": "Competition grid" }]
}
{% endschema %}
