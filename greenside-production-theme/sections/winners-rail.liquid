{%- comment -%}
  Winners rail.

  Reads the `winner` metaobject. If no winner entries exist yet the section
  renders an honest empty state rather than placeholder people — the theme will
  never invent a winner.
{%- endcomment -%}

{%- liquid
  assign winners = shop.metaobjects.winner.values
  assign limit = section.settings.winners_to_show | default: 4
-%}

{%- render 'section-styles',
  id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- assign winners_eyebrow = 'winners.eyebrow' | t -%}
        <span class="eyebrow eyebrow--highlight">
          {{- section.settings.eyebrow | default: winners_eyebrow | escape -}}
        </span>
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="text-muted">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.link != blank and winners.size > 0 -%}
        {%- assign winners_link_label = 'general.view_all' | t -%}
        <a class="link" href="{{ section.settings.link }}">
          {{- section.settings.link_label | default: winners_link_label | escape }}
          {%- render 'icon', icon: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    {%- if winners.size > 0 -%}
      <ul class="winner-strip" role="list">
        {%- for winner in winners limit: limit -%}
          <li>{%- render 'winner-card', winner: winner -%}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state">
        <span class="empty-state__icon">{%- render 'icon', icon: 'trophy', size: 28 -%}</span>
        <p class="h4">{{ 'winners.empty_title' | t }}</p>
        <p class="empty-state__text">{{ 'winners.empty_body' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Winners",
  "tag": "section",
  "class": "section-winners",
  "settings": [
    {
      "type": "paragraph",
      "content": "Winners come from the `winner` metaobject. Until you publish your first winner, this section shows an explanatory message rather than example people."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real people. Real prizes." },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Recent winners" },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading" },
    { "type": "range", "id": "winners_to_show", "min": 2, "max": 12, "step": 1, "label": "Winners to show", "default": 4 },
    { "type": "text", "id": "link_label", "label": "t:sections.all.link_label", "default": "All winners" },
    { "type": "url", "id": "link", "label": "t:sections.all.link" },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "cream"
    },
    { "type": "header", "content": "t:sections.all.padding_header" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 10, "unit": "%", "label": "t:sections.all.padding_bottom", "default": 100 }
  ],
  "presets": [{ "name": "Winners" }]
}
{% endschema %}
