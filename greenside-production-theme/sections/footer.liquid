<footer class="footer" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- liquid
          assign footer_logo = settings.logo_light | default: settings.logo
        -%}
        {%- if footer_logo -%}
          <img
            src="{{ footer_logo | image_url: width: 480 }}"
            alt="{{ shop.name | escape }}"
            width="{{ footer_logo.width }}"
            height="{{ footer_logo.height }}"
            loading="lazy"
          >
        {%- else -%}
          <p class="header__logo-text">{{ shop.name }}</p>
        {%- endif -%}

        {%- if section.settings.about_text != blank -%}
          <div class="footer__tagline rte">{{ section.settings.about_text }}</div>
        {%- elsif settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ settings.brand_tagline | escape }}</p>
        {%- endif -%}

        {%- render 'social-links' -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign footer_menu = linklists[block.settings.menu] -%}
            {%- if footer_menu.links.size > 0 -%}
              <nav class="footer__column" aria-labelledby="FooterHeading-{{ block.id }}" {{ block.shopify_attributes }}>
                <h2 class="footer__heading" id="FooterHeading-{{ block.id }}">
                  {{- block.settings.heading | default: footer_menu.title | escape -}}
                </h2>
                <ul class="footer__list">
                  {%- for link in footer_menu.links -%}
                    <li>
                      <a class="footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                        {{- link.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="footer__tagline rte">{{ block.settings.text }}</div>
            </div>

          {%- when 'newsletter' -%}
            <div class="footer__column footer__column--newsletter" {{ block.shopify_attributes }}>
              {%- assign newsletter_heading = 'footer.newsletter_heading' | t -%}
              <h2 class="footer__heading">
                {{- block.settings.heading | default: newsletter_heading | escape -}}
              </h2>
              {%- if block.settings.text != blank -%}
                <div class="footer__tagline rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- render 'newsletter-form', id: block.id, location: 'footer', compact: true -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <p>
          {{ 'footer.copyright' | t: year: 'now' | date: '%Y', shop: shop.name }}
          {%- if section.settings.show_policy_links -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank %} &middot;
                <a class="footer__link" href="{{ policy.url }}">{{ policy.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </p>
        {%- if settings.legal_footer_text != blank -%}
          <div class="rte">{{ settings.legal_footer_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>Premium golf prizes, entry prices that make sense, and every draw published in full.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policy links",
      "info": "Pulls in whichever policies you have published in Shopify settings.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading" },
        { "type": "richtext", "id": "text", "label": "t:sections.all.content" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "The Greenside Club" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.content",
          "default": "<p>New competitions, draw results and the odd bit of golf. No spam.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
