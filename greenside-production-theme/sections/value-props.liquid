{%- render 'section-styles',
  id: section.id,
  top: section.settings.spacing_top,
  bottom: section.settings.spacing_bottom
-%}

<div class="section scheme-{{ section.settings.colour_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.alignment == 'center' %} section-header--center{% endif %}">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="text-lead">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="value-grid" role="list">
        {%- for block in section.blocks -%}
          <li class="value-card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="value-card__icon">{%- render 'icon', icon: block.settings.icon, size: 24 -%}</span>
            {%- endif -%}
            <h3 class="value-card__title h4">{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="value-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a class="link" href="{{ block.settings.link }}">
                {{- block.settings.link_label | escape }}
                {%- render 'icon', icon: 'arrow-right', size: 14 -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Why Greenside",
  "tag": "section",
  "class": "section-value-props",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Why Greenside" },
    { "type": "text", "id": "subheading", "label": "t:sections.all.subheading" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.alignment",
      "options": [
        { "value": "left", "label": "t:sections.all.align_left" },
        { "value": "center", "label": "t:sections.all.align_center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "t:sections.all.colour_scheme",
      "options": [
        { "value": "light", "label": "t:sections.all.scheme_light" },
        { "value": "cream", "label": "t:sections.all.scheme_cream" },
        { "value": "brand", "label": "t:sections.all.scheme_brand" },
        { "value": "deep", "label": "t:sections.all.scheme_deep" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "t:sections.all.spacing_header" },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:sections.all.spacing_top",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:sections.all.spacing_bottom",
      "options": [
        { "value": "major", "label": "t:sections.all.space_major" },
        { "value": "standard", "label": "t:sections.all.space_standard" },
        { "value": "minor", "label": "t:sections.all.space_minor" },
        { "value": "none", "label": "t:sections.all.space_none" }
      ],
      "default": "standard"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "ticket", "label": "Ticket" },
            { "value": "shield", "label": "Shield" },
            { "value": "flag", "label": "Flag" },
            { "value": "users", "label": "People" },
            { "value": "golf-flag", "label": "Golf flag" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "gift", "label": "Gift" },
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" }
          ],
          "default": "trophy"
        },
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Prizes worth winning" },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.content",
          "default": "<p>Kit from the brands you already play, not whatever was cheapest to source.</p>"
        },
        { "type": "text", "id": "link_label", "label": "t:sections.all.link_label" },
        { "type": "url", "id": "link", "label": "t:sections.all.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Greenside",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "trophy",
            "heading": "Prizes worth winning",
            "text": "<p>Kit from the brands you already play, not whatever was cheapest to source.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "ticket",
            "heading": "Entries that make sense",
            "text": "<p>Capped entry numbers, published up front, so you always know what you're entering.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shield",
            "heading": "Draws you can check",
            "text": "<p>Every draw is recorded and every winner is published. Nothing happens off camera.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "users",
            "heading": "Built by golfers",
            "text": "<p>We play. That's why the prizes are things we'd want in our own bags.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
