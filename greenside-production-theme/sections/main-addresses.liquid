{{ 'component-account.css' | asset_url | stylesheet_tag }}

<div class="account-page">
  <div class="page-width">
    <div class="account-header">
      <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
      <a class="link" href="{{ routes.account_url }}">
        {%- render 'icon', icon: 'arrow-left', size: 16 -%}
        {{ 'customer.order.back' | t }}
      </a>
    </div>

    <div class="account-layout">
      {%- render 'account-nav', current: 'addresses' -%}

      <div>
        <section class="account-panel">
          <h2 class="h4 account-panel__title">{{ 'customer.addresses.add_new' | t }}</h2>

          {%- form 'customer_address', customer.new_address, class: 'address-form' -%}
            {%- render 'address-fields', form: form, prefix: 'AddressNew' -%}
            <label class="checkbox" for="AddressNewDefault">
              {{ form.set_as_default_checkbox }}
              <span>{{ 'customer.addresses.set_default' | t }}</span>
            </label>
            <button type="submit" class="button button--primary" style="justify-self: start;">
              {{- 'customer.addresses.submit' | t -}}
            </button>
          {%- endform -%}
        </section>

        {%- paginate customer.addresses by 6 -%}
          {%- if customer.addresses.size > 0 -%}
            <ul class="address-grid" role="list" style="margin-top: 1.5rem;">
              {%- for address in customer.addresses -%}
                <li class="address-card">
                  {%- if address == customer.default_address -%}
                    <p class="badge badge--brand" style="margin-bottom: 0.75rem;">
                      {{- 'customer.addresses.default' | t -}}
                    </p>
                  {%- endif -%}

                  <div class="text-sm">{{ address | format_address }}</div>

                  <div class="address-card__actions">
                    <button
                      type="button"
                      class="link"
                      aria-expanded="false"
                      aria-controls="EditAddress-{{ address.id }}"
                      data-address-toggle="EditAddress-{{ address.id }}"
                    >
                      {{- 'customer.addresses.edit' | t -}}
                    </button>

                    <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
                      <input type="hidden" name="_method" value="delete">
                      <button
                        type="submit"
                        class="link"
                        data-confirm-message="{{ 'customer.addresses.delete_confirm' | t | escape }}"
                      >
                        {{- 'customer.addresses.delete' | t -}}
                      </button>
                    </form>
                  </div>

                  <div id="EditAddress-{{ address.id }}" hidden>
                    {%- form 'customer_address', address, class: 'address-form' -%}
                      {%- render 'address-fields', form: form, prefix: address.id -%}
                      <label class="checkbox" for="Address{{ address.id }}Default">
                        {{ form.set_as_default_checkbox }}
                        <span>{{ 'customer.addresses.set_default' | t }}</span>
                      </label>
                      <div class="flow-gap">
                        <button type="submit" class="button button--primary button--small">
                          {{- 'customer.addresses.submit' | t -}}
                        </button>
                        <button
                          type="button"
                          class="button button--secondary button--small"
                          data-address-toggle="EditAddress-{{ address.id }}"
                        >
                          {{- 'customer.addresses.cancel' | t -}}
                        </button>
                      </div>
                    {%- endform -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          {%- else -%}
            <p class="text-muted" style="margin-top: 1.5rem;">{{ 'customer.addresses.none' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'addresses.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "class": "section-main-addresses",
  "settings": []
}
{% endschema %}
