{%- comment -%}
  Prize gallery.

  A scroll-snap rail with thumbnail buttons.

  The thumbnails are toggle buttons with aria-pressed rather than an ARIA
  tablist. A tablist implies only one panel is present at a time, which is not
  true of a scroller where every image is in the document and reachable by
  swiping — and the mismatch produced real axe violations. Toggle buttons
  describe what these controls actually do.

  The rail itself is focusable and labelled, so a keyboard user can scroll it
  directly. With JavaScript disabled the rail still scrolls and every image is
  reachable.

  Parameters:
    product (required)
{%- endcomment -%}

{%- assign media_items = product.media -%}

<gs-gallery class="gallery" data-gallery>
  {%- if media_items.size > 0 -%}
    <div class="gallery__viewport">
      <div
        class="gallery__track"
        data-gallery-track
        {% if media_items.size > 1 %}
          tabindex="0"
          role="group"
          aria-label="{{ 'products.product.gallery_thumbnail' | t: index: media_items.size }}"
        {% endif %}
      >
        {%- for media in media_items -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <div class="gallery__slide" data-gallery-slide data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- render 'responsive-image',
                  image: media.preview_image,
                  alt: media_alt,
                  sizes: '(min-width: 990px) 640px, 100vw',
                  widths: '540,720,900,1200,1600',
                  loading: 'eager'
                -%}
              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1200x', controls: true, muted: false }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if media_items.size > 1 -%}
        <button
          type="button"
          class="gallery__nav gallery__nav--prev"
          data-gallery-prev
          aria-label="{{ 'general.accessibility.previous' | t }}"
        >
          {%- render 'icon', icon: 'chevron-left', size: 20 -%}
        </button>
        <button
          type="button"
          class="gallery__nav gallery__nav--next"
          data-gallery-next
          aria-label="{{ 'general.accessibility.next' | t }}"
        >
          {%- render 'icon', icon: 'chevron-right', size: 20 -%}
        </button>
      {%- endif -%}
    </div>

    {%- if media_items.size > 1 -%}
      <ul class="gallery__thumbs" data-gallery-thumbs role="list">
        {%- for media in media_items -%}
          <li>
            <button
              type="button"
              class="gallery__thumb"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media_of' | t: index: forloop.index, total: media_items.size }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' }}"
                alt=""
                width="80"
                height="80"
                loading="lazy"
              >
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- else -%}
    <div class="gallery__viewport">
      <div class="media media--landscape">
        {%- render 'placeholder', name: 'product-1' -%}
      </div>
    </div>
  {%- endif -%}
</gs-gallery>
