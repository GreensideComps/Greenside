{%- comment -%}
  JSON-LD.

  Rules applied throughout:
  - `aggregateRating` and `review` are emitted only when a real review metafield
    holds values. There is no fallback, so the theme can never publish a rating
    that does not exist.
  - `offers.availability` mirrors Shopify's own inventory state.
  - Breadcrumbs mirror the visible breadcrumb trail.
{%- endcomment -%}

{%- liquid
  assign org_logo = settings.logo | default: settings.share_image
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | append: routes.root_url | json }}
    {%- if org_logo %},
    "logo": {{ org_logo | image_url: width: 600 | prepend: "https:" | json }}
    {%- endif -%}
    {%- assign social_links = '' -%}
    {%- if settings.social_instagram_link != blank %}{% assign social_links = social_links | append: settings.social_instagram_link | append: '|' %}{% endif -%}
    {%- if settings.social_facebook_link != blank %}{% assign social_links = social_links | append: settings.social_facebook_link | append: '|' %}{% endif -%}
    {%- if settings.social_tiktok_link != blank %}{% assign social_links = social_links | append: settings.social_tiktok_link | append: '|' %}{% endif -%}
    {%- if settings.social_youtube_link != blank %}{% assign social_links = social_links | append: settings.social_youtube_link | append: '|' %}{% endif -%}
    {%- if settings.social_x_link != blank %}{% assign social_links = social_links | append: settings.social_x_link | append: '|' %}{% endif -%}
    {%- if social_links != blank -%}
      {%- assign social_array = social_links | split: '|' -%},
    "sameAs": [
      {%- for link in social_array -%}
        {{ link | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- comment -%}
    The `{search_term_string}` placeholder is written as literal text, outside any
    output tag. Inside one, Shopify's Liquid parser ends the tag at the first `}`
    of the placeholder and prints the rest of the tag as an error onto the page.
  {%- endcomment -%}
  {%- assign search_target = shop.url | append: routes.search_url -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ search_target }}?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign product_media = product.featured_media
    assign closing_at = product.metafields.custom.closing_at
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      {%- if product_media %}
      "image": [
        {%- for media in product.media limit: 5 -%}
          {{ media | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- endif %}
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {%- if product.vendor != blank %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      {%- endif %}
      {%- if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/SoldOut"{% endif %}
        {%- if closing_at != blank -%},
        "priceValidUntil": {{ closing_at | date: '%Y-%m-%d' | json }}
        {%- endif %}
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      {%- if article.image %}
      "image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}],
      {%- endif %}
      {%- if article.author != blank %}
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      {%- endif %}
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      },
      "mainEntityOfPage": {{ shop.url | append: article.url | json }}
    }
  </script>
{%- endif -%}

{%- comment -%} Breadcrumbs mirror snippets/breadcrumbs.liquid. {%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'password' or request.page_type == 'cart' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'general.home' | t | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        }
        {%- case request.page_type -%}
          {%- when 'product' -%}
            {%- if collection.url %},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ shop.url | append: collection.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
            {%- else -%},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
            {%- endif -%}
          {%- when 'collection' -%},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ shop.url | append: collection.url | json }}
            }
          {%- when 'page' -%},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": {{ shop.url | append: page.url | json }}
            }
          {%- when 'article' -%},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ shop.url | append: article.url | json }}
            }
          {%- when 'blog' -%},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            }
        {%- endcase -%}
      ]
    }
  </script>
{%- endunless -%}
