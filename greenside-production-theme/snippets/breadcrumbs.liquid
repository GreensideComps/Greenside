{%- comment -%}
  Breadcrumb trail. Mirrors the BreadcrumbList JSON-LD in structured-data.liquid
  so the visible trail and the markup never disagree.
{%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'password' -%}
  <nav class="breadcrumbs" aria-label="{{ 'general.accessibility.breadcrumbs' | t }}">
    <ol>
      <li>
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        {%- render 'icon', icon: 'chevron-right', size: 12 -%}
      </li>

      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection.url -%}
            <li>
              <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
              {%- render 'icon', icon: 'chevron-right', size: 12 -%}
            </li>
          {%- endif -%}
          <li><span aria-current="page">{{ product.title | escape | truncate: 60 }}</span></li>

        {%- when 'collection' -%}
          <li><span aria-current="page">{{ collection.title | escape }}</span></li>

        {%- when 'page' -%}
          <li><span aria-current="page">{{ page.title | escape }}</span></li>

        {%- when 'blog' -%}
          <li><span aria-current="page">{{ blog.title | escape }}</span></li>

        {%- when 'article' -%}
          <li>
            <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
            {%- render 'icon', icon: 'chevron-right', size: 12 -%}
          </li>
          <li><span aria-current="page">{{ article.title | escape | truncate: 60 }}</span></li>

        {%- when 'search' -%}
          <li><span aria-current="page">{{ 'general.search.title' | t }}</span></li>

        {%- else -%}
          <li><span aria-current="page">{{ page_title | escape }}</span></li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}
