{%- comment -%}
  Badges.

  One badge on a card, always. Three urgency signals stacked on one component is
  how a competition site starts to look like a slot machine, and each one of them
  being factually true does not change how it reads.

  Priority, highest first, so the most decision-relevant badge survives the cut:
    1. Closed / fully entered  — blocks entry, so it must always win
    2. Instant win             — changes the mechanic
    3. Merchant badge          — custom.badge_label
    4. Closing soon            — a real date inside 48 hours
    5. New

  "Featured" is deliberately not a badge. It describes the merchant's opinion,
  not the competition, and it was appearing on cards inside a section already
  headed "Featured".

  Brass appears nowhere here. It means winners.

  Parameters:
    product  (required)
    max      maximum badges (default 1; the competition page passes more)
    context  'card' (default) or 'page'
{%- endcomment -%}

{%- liquid
  assign max_badges = max | default: 1
  if context == 'page'
    assign max_badges = 4
  endif

  assign closing_at = product.metafields.custom.closing_at.value
  assign instant_win = product.metafields.custom.instant_win.value
  assign badge_label = product.metafields.custom.badge_label.value

  assign is_closed = false
  assign is_closing_soon = false

  if closing_at != blank
    assign now_stamp = 'now' | date: '%s' | times: 1
    assign close_stamp = closing_at | date: '%s' | times: 1
    assign seconds_left = close_stamp | minus: now_stamp
    if seconds_left <= 0
      assign is_closed = true
    elsif seconds_left <= 172800
      assign is_closing_soon = true
    endif
  endif

  assign badges = ''

  if is_closed
    assign badges = badges | append: 'closed|'
  elsif product.available == false
    assign badges = badges | append: 'full|'
  endif

  if instant_win
    assign badges = badges | append: 'instant|'
  endif

  if badge_label != blank
    assign badges = badges | append: 'custom|'
  endif

  if is_closing_soon and is_closed == false and product.available
    assign badges = badges | append: 'closing|'
  endif

  if product.tags contains 'new'
    assign badges = badges | append: 'new|'
  endif

  assign badge_list = badges | split: '|'
-%}

{%- if badge_list.size > 0 -%}
  <div class="competition-card__badges">
    {%- for badge in badge_list limit: max_badges -%}
      {%- case badge -%}
        {%- when 'closed' -%}
          <span class="badge badge--closed">{{ 'products.competition.badge_closed' | t }}</span>
        {%- when 'full' -%}
          <span class="badge badge--closed">{{ 'products.competition.badge_sold_out' | t }}</span>
        {%- when 'closing' -%}
          <span class="badge badge--quiet">{{ 'products.competition.badge_closing_soon' | t }}</span>
        {%- when 'instant' -%}
          <span class="badge badge--quiet">{{ 'products.competition.badge_instant_win' | t }}</span>
        {%- when 'custom' -%}
          <span class="badge badge--quiet">{{ badge_label | escape }}</span>
        {%- when 'new' -%}
          <span class="badge badge--quiet">{{ 'products.competition.badge_new' | t }}</span>
      {%- endcase -%}
    {%- endfor -%}
  </div>
{%- endif -%}
