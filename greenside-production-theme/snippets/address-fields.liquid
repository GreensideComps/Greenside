{%- comment -%}
  Address form fields, shared by the new and edit forms.

  Country and province use Shopify's own option tags so the province list always
  matches the chosen country.

  Parameters:
    form   (required) a customer_address form object
    prefix (required) unique id prefix
{%- endcomment -%}
<div class="address-form__row">
  <div class="field">
    <label class="field__label" for="Address{{ prefix }}FirstName">
      {{- 'customer.addresses.first_name' | t -}}
    </label>
    <input
      id="Address{{ prefix }}FirstName"
      class="field__input"
      type="text"
      name="address[first_name]"
      value="{{ form.first_name }}"
      autocomplete="given-name"
    >
  </div>
  <div class="field">
    <label class="field__label" for="Address{{ prefix }}LastName">
      {{- 'customer.addresses.last_name' | t -}}
    </label>
    <input
      id="Address{{ prefix }}LastName"
      class="field__input"
      type="text"
      name="address[last_name]"
      value="{{ form.last_name }}"
      autocomplete="family-name"
    >
  </div>
</div>

<div class="field">
  <label class="field__label" for="Address{{ prefix }}Company">{{ 'customer.addresses.company' | t }}</label>
  <input
    id="Address{{ prefix }}Company"
    class="field__input"
    type="text"
    name="address[company]"
    value="{{ form.company }}"
    autocomplete="organization"
  >
</div>

<div class="field">
  <label class="field__label" for="Address{{ prefix }}Address1">{{ 'customer.addresses.address1' | t }}</label>
  <input
    id="Address{{ prefix }}Address1"
    class="field__input"
    type="text"
    name="address[address1]"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
  >
</div>

<div class="field">
  <label class="field__label" for="Address{{ prefix }}Address2">{{ 'customer.addresses.address2' | t }}</label>
  <input
    id="Address{{ prefix }}Address2"
    class="field__input"
    type="text"
    name="address[address2]"
    value="{{ form.address2 }}"
    autocomplete="address-line2"
  >
</div>

<div class="address-form__row">
  <div class="field">
    <label class="field__label" for="Address{{ prefix }}City">{{ 'customer.addresses.city' | t }}</label>
    <input
      id="Address{{ prefix }}City"
      class="field__input"
      type="text"
      name="address[city]"
      value="{{ form.city }}"
      autocomplete="address-level2"
    >
  </div>
  <div class="field">
    <label class="field__label" for="Address{{ prefix }}Zip">{{ 'customer.addresses.zip' | t }}</label>
    <input
      id="Address{{ prefix }}Zip"
      class="field__input"
      type="text"
      name="address[zip]"
      value="{{ form.zip }}"
      autocapitalize="characters"
      autocomplete="postal-code"
    >
  </div>
</div>

<div class="field">
  <label class="field__label" for="Address{{ prefix }}Country">{{ 'customer.addresses.country' | t }}</label>
  <select
    id="Address{{ prefix }}Country"
    class="field__select"
    name="address[country]"
    data-address-country
    data-default="{{ form.country }}"
    autocomplete="country"
  >
    {{ all_country_option_tags }}
  </select>
</div>

<div class="field" id="Address{{ prefix }}ProvinceWrapper" data-address-province-wrapper hidden>
  <label class="field__label" for="Address{{ prefix }}Province">{{ 'customer.addresses.province' | t }}</label>
  <select
    id="Address{{ prefix }}Province"
    class="field__select"
    name="address[province]"
    data-address-province
    data-default="{{ form.province }}"
    autocomplete="address-level1"
  ></select>
</div>

<div class="field">
  <label class="field__label" for="Address{{ prefix }}Phone">{{ 'customer.addresses.phone' | t }}</label>
  <input
    id="Address{{ prefix }}Phone"
    class="field__input"
    type="tel"
    name="address[phone]"
    value="{{ form.phone }}"
    autocomplete="tel"
  >
</div>
