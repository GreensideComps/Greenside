<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  class="no-js"
  {% if settings.enable_motion == false %}data-reduced-motion="true"{% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_brand | default: '#1b4332' }}">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {%- comment -%}
      Design tokens go inline so the first paint already has the brand applied.
      Everything else is a cached stylesheet.
    {%- endcomment -%}
    <style>{%- render 'css-variables' -%}</style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ template.name | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}"
    data-cart-behaviour="{{ settings.cart_behaviour | default: 'drawer' }}"
  >
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- render 'analytics-bootstrap' -%}

    <div id="shopify-section-announcement" class="announcement-host">
      {% sections 'header-group' %}
    </div>

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_behaviour == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      {%- render 'search-modal' -%}
    {%- endif -%}

    {%- comment -%} Live region shared by every async interaction on the page. {%- endcomment -%}
    <div
      id="GsLiveRegion"
      class="visually-hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'general.accessibility.new_window' | t }}</li>
    </ul>

    {%- comment -%}
      Strings the JavaScript needs. Kept as JSON in a script tag so nothing is
      interpolated straight into executable code.
    {%- endcomment -%}
    <script type="application/json" id="GsStrings">
      {
        "cartError": {{ 'general.errors.generic' | t | json }},
        "networkError": {{ 'general.errors.network' | t | json }},
        "quantityError": {{ 'cart.quantity_error_generic' | t | json }},
        "addedToCart": {{ 'cart.added_to_cart' | t | json }},
        "copied": {{ 'general.share.copied' | t | json }},
        "loading": {{ 'general.accessibility.loading' | t | json }},
        "searchNoResults": {{ 'general.search.no_predictive_results' | t | json }},
        "searchResultsAvailable": {{ 'general.search.results_available' | t | json }}
      }
    </script>

    <script type="application/json" id="GsConfig">
      {
        "routes": {
          "root": {{ routes.root_url | json }},
          "cart": {{ routes.cart_url | json }},
          "cartAdd": {{ routes.cart_add_url | json }},
          "cartChange": {{ routes.cart_change_url | json }},
          "cartUpdate": {{ routes.cart_update_url | json }},
          "predictiveSearch": {{ routes.predictive_search_url | json }},
          "search": {{ routes.search_url | json }},
          "account": {{ routes.account_url | json }},
          "accountLogin": {{ routes.account_login_url | json }}
        },
        "cartBehaviour": {{ settings.cart_behaviour | default: 'drawer' | json }},
        "moneyFormat": {{ shop.money_format | strip_html | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "analytics": {
          "enabled": {{ settings.analytics_enabled | default: false | json }},
          "debug": {{ settings.analytics_debug | default: false | json }}
        },
        "customer": {
          "loggedIn": {% if customer %}true{% else %}false{% endif %}
        },
        "entryProgressEndpoint": {{ settings.entry_progress_endpoint | default: '' | json }},
        "referral": {
          "baseUrl": {{ settings.referral_base_url | default: '' | json }},
          "param": {{ settings.referral_query_param | default: 'ref' | json }}
        }
      }
    </script>
  </body>
</html>
