<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_brand | default: '#1b4332' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <style>{%- render 'css-variables' -%}</style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.remove('no-js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    <div id="GsLiveRegion" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>

    <script type="application/json" id="GsConfig">
      {
        "routes": { "root": {{ routes.root_url | json }} },
        "moneyFormat": {{ shop.money_format | strip_html | json }},
        "analytics": {
          "enabled": {{ settings.analytics_enabled | default: false | json }},
          "debug": {{ settings.analytics_debug | default: false | json }}
        },
        "customer": { "loggedIn": false }
      }
    </script>
    <script type="application/json" id="GsPageMeta">
      { "pageType": "password", "template": "password" }
    </script>
  </body>
</html>
