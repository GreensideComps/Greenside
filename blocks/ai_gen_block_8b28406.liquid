{% doc %}
  @prompt
    Rebuild this Prize Showcase section for a golf competition website called Greenside Competitions. It must look identical to the current design but use a repeatable block structure so the merchant can add unlimited prize cards in the theme editor. The section has a dark background with the golf equipment flat lay image. Each prize card has: an image, a title, a short description, and a "Planned prize" label/badge. Pre-fill with these 6 cards: 1) Title "Premium Drivers", image of a premium golf driver, description "Top of the range drivers from the world's leading brands." 2) Title "Scotty Cameron Putters", image of a premium putter, description "Iconic putters used by the world's best golfers." 3) Title "TaylorMade Irons", image of a set of irons, description "Precision irons to elevate your game." 4) Title "Garmin Golf Watches", image of a golf GPS watch, description "Track every shot with cutting-edge golf technology." 5) Title "Premium Golf Bags", image of a premium golf bag, description "Carry your clubs in style with a top-spec golf bag." 6) Title "And More!", image of golf balls, wedges and hats on white background, description "More premium golf prizes to be revealed at launch." Cards should display in a responsive grid, centred, handling both even and odd numbers of cards gracefully.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-prize-card-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-prize-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-prize-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-prize-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-prize-card-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-prize-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-prize-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-prize-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-prize-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }
{% endstyle %}

<div class="ai-prize-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-prize-card-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 600 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="600"
        height="600"
        class="ai-prize-card-image-{{ ai_gen_id }}"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
    
    {% if block.settings.show_badge and block.settings.badge_text != blank %}
      <div class="ai-prize-card-badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}
  </div>

  <div class="ai-prize-card-content-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h3 class="ai-prize-card-title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h3>
    {% endif %}

    {% if block.settings.description != blank %}
      <p class="ai-prize-card-description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Prize card",
  "settings": [
    {
      "type": "header",
      "content": "Prize details"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Premium Drivers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Top of the range drivers from the world's leading brands."
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Planned prize"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#1b4332"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Badge border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Content padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1b4332"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Prize card"
    }
  ]
}
{% endschema %}