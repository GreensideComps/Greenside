{% doc %}
  Prize Showcase - 3-col grid desktop, 2-col compact mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-prize-showcase-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-prize-showcase-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-prize-showcase-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ block.settings.background_image_opacity | divided_by: 100.0 }};
  }

  .ai-prize-showcase-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-prize-showcase-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-prize-showcase-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 16px;
    font-weight: 700;
  }

  .ai-prize-showcase-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-prize-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0 auto;
  }

 .ai-prize-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .ai-prize-card-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .ai-prize-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: 100%;
    background-color: #f4f4f4;
    overflow: hidden;
  }

  .ai-prize-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-prize-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-prize-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-prize-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-prize-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-prize-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .ai-prize-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.card_description_color }};
    font-size: {{ block.settings.card_description_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-prize-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .ai-prize-card-content-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-prize-card-title-{{ ai_gen_id }} {
      font-size: 14px;
      margin: 0 0 6px;
    }

    .ai-prize-card-description-{{ ai_gen_id }} {
      font-size: 11px;
      line-height: 1.35;
    }

    .ai-prize-card-badge-{{ ai_gen_id }} {
      padding: 4px 8px;
      font-size: 9px;
      top: 8px;
      right: 8px;
    }

    .ai-prize-showcase-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-prize-showcase-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<prize-showcase-{{ ai_gen_id }} class="ai-prize-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image %}
    <div class="ai-prize-showcase-bg-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    </div>
  {% endif %}

  <div class="ai-prize-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-prize-showcase-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-prize-showcase-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-prize-showcase-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-prize-showcase-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign badge_key = 'card_' | append: i | append: '_badge'
          assign title_key = 'card_' | append: i | append: '_title'
          assign description_key = 'card_' | append: i | append: '_description'

          assign card_image = block.settings[image_key]
          assign card_badge = block.settings[badge_key]
          assign card_title = block.settings[title_key]
          assign card_description = block.settings[description_key]
        %}

        <div class="ai-prize-card-{{ ai_gen_id }}">
          <div class="ai-prize-card-image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 600 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-prize-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-prize-card-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            {% if card_badge != blank %}
              <div class="ai-prize-card-badge-{{ ai_gen_id }}">{{ card_badge }}</div>
            {% endif %}
          </div>
          <div class="ai-prize-card-content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-prize-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
            {% if card_description != blank %}
              <p class="ai-prize-card-description-{{ ai_gen_id }}">{{ card_description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</prize-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class PrizeShowcase{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('prize-showcase-{{ ai_gen_id }}', PrizeShowcase{{ai_gen_id}});
  })();
</script>

{% schema %}
