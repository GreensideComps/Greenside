    { "type": "range", "id": "cta_text_size_mobile", "label": "CTA text size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_text_size_mobile", "label": "Button text size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 16 },
